{
  "dashboard": {
    "id": null,
    "uid": "tenazas-training",
    "title": "Tenazas Auto Training",
    "tags": ["tenazas", "training", "ml"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "1m",
    "time": { "from": "now-30d", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "F1 Before (baseline)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "tenazas_training_f1_before",
            "legendFormat": "F1 Before"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.6 },
                { "color": "green", "value": 0.85 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "F1 After (finetuned)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "tenazas_training_f1_after",
            "legendFormat": "F1 After"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.6 },
                { "color": "green", "value": 0.85 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Model Swapped",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "tenazas_training_swapped",
            "legendFormat": "Swapped"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "No", "color": "yellow" }, "1": { "text": "Yes", "color": "green" } } }
            ]
          }
        }
      },
      {
        "id": 4,
        "title": "Total Training Runs",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
        "targets": [
          {
            "expr": "tenazas_training_runs_total",
            "legendFormat": "Runs"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "blue" }
          }
        }
      },
      {
        "id": 5,
        "title": "F1 Evolution — Baseline vs Finetuned",
        "description": "F1 score over time. Green = after training, orange = before training.",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
        "targets": [
          {
            "expr": "tenazas_training_f1_before",
            "legendFormat": "F1 Before (baseline)"
          },
          {
            "expr": "tenazas_training_f1_after",
            "legendFormat": "F1 After (finetuned)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 15,
              "pointSize": 6,
              "showPoints": "always",
              "spanNulls": true
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "F1 Before (baseline)" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "F1 After (finetuned)" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
              ]
            }
          ]
        }
      },
      {
        "id": 6,
        "title": "F1 Improvement (delta)",
        "description": "Difference between F1 after and before. Positive = model improved.",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "tenazas_training_f1_after - tenazas_training_f1_before",
            "legendFormat": "F1 Delta"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "drawStyle": "bars",
              "lineWidth": 1,
              "fillOpacity": 50,
              "pointSize": 5,
              "showPoints": "always"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0 },
                { "color": "green", "value": 0.02 }
              ]
            },
            "color": { "mode": "thresholds" }
          }
        }
      }
    ]
  },
  "overwrite": true
}
