{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Tenazas — Eval del modelo multitool (fine-tuning vs baseline vs 3b)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Metricas globales -- ultimo eval",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Exact Match",
      "description": "Porcentaje de queries donde el modelo eligio exactamente las tools correctas",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizHeight": 75,
        "minVizWidth": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.60 },
              { "color": "yellow", "value": 0.70 },
              { "color": "green",  "value": 0.85 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [{
        "expr": "tenazas_eval_exact_match",
        "legendFormat": "{{model}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "title": "F1 Score",
      "description": "Media armonica de precision y recall",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.65 },
              { "color": "yellow", "value": 0.80 },
              { "color": "green",  "value": 0.90 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_f1",
        "legendFormat": "{{model}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 3,
      "title": "Precision",
      "description": "De las tools que eligio, cuantas eran correctas",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.65 },
              { "color": "yellow", "value": 0.80 },
              { "color": "green",  "value": 0.90 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_precision",
        "legendFormat": "{{model}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 4,
      "title": "Recall",
      "description": "De las tools que debia elegir, cuantas eligio",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.65 },
              { "color": "yellow", "value": 0.80 },
              { "color": "green",  "value": 0.90 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_recall",
        "legendFormat": "{{model}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 5,
      "title": "Hallucination Rate",
      "description": "Tools predichas que no existen en el registry -- debe ser < 5%",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "orange", "value": 0.05 },
              { "color": "red",    "value": 0.10 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_hallucination_rate",
        "legendFormat": "{{model}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 6,
      "title": "Over / Under Trigger",
      "description": "Over: eligio tools cuando no debia. Under: no eligio cuando debia.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "orange", "value": 0.10 },
              { "color": "red",    "value": 0.20 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "tenazas_eval_over_trigger_rate",
          "legendFormat": "over -- {{model}}",
          "refId": "A"
        },
        {
          "expr": "tenazas_eval_under_trigger_rate",
          "legendFormat": "under -- {{model}}",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "F1 por tool -- fine-tuned vs baseline",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Per-tool F1 -- finetuned",
      "description": "F1 score por tool del modelo fine-tuned. Verde > 0.85, rojo < 0.60. Tools con F1 bajo necesitan mas ejemplos en el dataset.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 10,
        "minVizWidth": 0,
        "valueMode": "color",
        "namePlacement": "auto",
        "legendDisplayMode": "list"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.60 },
              { "color": "yellow", "value": 0.75 },
              { "color": "green",  "value": 0.85 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_f1_per_tool{model=\"finetuned\"}",
        "legendFormat": "{{tool}}",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 11,
      "title": "Per-tool F1 -- baseline",
      "description": "F1 score del modelo sin fine-tuning. Comparar con el panel izquierdo.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 10,
        "minVizWidth": 0,
        "valueMode": "color",
        "namePlacement": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.60 },
              { "color": "yellow", "value": 0.75 },
              { "color": "green",  "value": 0.85 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_f1_per_tool{model=\"baseline\"}",
        "legendFormat": "{{tool}}",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Evolucion en el tiempo -- evals historicos",
      "type": "row"
    },
    {
      "id": 20,
      "title": "F1 historico -- todos los modelos",
      "description": "Evolucion del F1 a lo largo de los evals. Cada punto = una corrida de eval_runner.py.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 17 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8ab8ff" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "tenazas_eval_f1{model=\"finetuned\"}",
          "legendFormat": "F1 finetuned",
          "refId": "A"
        },
        {
          "expr": "tenazas_eval_f1{model=\"baseline\"}",
          "legendFormat": "F1 baseline",
          "refId": "B"
        },
        {
          "expr": "tenazas_eval_f1{model=\"3b_baseline\"}",
          "legendFormat": "F1 3b_baseline",
          "refId": "C"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 21,
      "title": "Delta F1 (finetuned - baseline)",
      "description": "Verde = el fine-tuning mejoro. Rojo = el fine-tuning empeoro.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 6,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 0.0 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "expr": "scalar(tenazas_eval_f1{model=\"finetuned\"}) - scalar(tenazas_eval_f1{model=\"baseline\"})",
        "legendFormat": "Delta F1",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "Alertas de calidad",
      "type": "row"
    },
    {
      "id": 30,
      "title": "Estado del modelo",
      "description": "LISTO = F1 > 0.80 y hallucination < 5%. REVISAR = alguna metrica fuera de rango.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 26 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "LISTO",   "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "REVISAR", "color": "red"   } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      },
      "targets": [{
        "expr": "(tenazas_eval_f1{model=\"finetuned\"} > bool 0.80) * (tenazas_eval_hallucination_rate{model=\"finetuned\"} < bool 0.05)",
        "legendFormat": "Calidad",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 31,
      "title": "Ultimo eval",
      "description": "Timestamp del ultimo archivo de eval procesado",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 26 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name",
        "colorMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "dateTimeAsIso" }
      },
      "targets": [{
        "expr": "tenazas_eval_file_mtime_seconds{model=\"finetuned\"} * 1000",
        "legendFormat": "Finetuned",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 32,
      "title": "Resumen de umbrales",
      "description": "Metricas globales de todos los modelos. Verde > 0.85, amarillo > 0.70, rojo < 0.70.",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 26 },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "align": "center", "displayMode": "color-background" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "green",  "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "tenazas_eval_f1",
          "legendFormat": "F1 {{model}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_eval_precision",
          "legendFormat": "Precision {{model}}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_eval_recall",
          "legendFormat": "Recall {{model}}",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_eval_exact_match",
          "legendFormat": "Exact {{model}}",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 33,
      "title": "Exporter Status",
      "description": "1 = exporter corriendo. 0 = caido.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 30 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red"   } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      },
      "targets": [{
        "expr": "tenazas_eval_exporter_up",
        "legendFormat": "Exporter",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tenazas", "multitool", "ml", "eval"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "America/Argentina/Buenos_Aires",
  "title": "Tenazas — Multitool Eval",
  "uid": "tenazas-multitool-eval",
  "version": 2
}
