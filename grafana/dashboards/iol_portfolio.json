{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Portfolio IOL InvertirOnline - Vista Analista. Valor total, P&L, freshness, posiciones, evolucion historica.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Metricas principales",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Valor Total Portfolio",
      "description": "Valor total del portfolio IOL en ARS (API directa)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E24B4A", "value": null },
              { "color": "#EF9F27", "value": 1000000 },
              { "color": "#639922", "value": 5000000 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "iol_portfolio_value_ars",
        "legendFormat": "Portfolio",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "title": "P&L del Dia",
      "description": "Resultado del dia en ARS. Verde = ganancia, rojo = perdida.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E24B4A", "value": null },
              { "color": "#888780", "value": -100 },
              { "color": "#639922", "value": 100 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "iol_portfolio_pnl_day_ars",
        "legendFormat": "P&L Hoy",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 3,
      "title": "Freshness",
      "description": "Tiempo desde la ultima coleccion exitosa de IOL. Verde < 5m, amarillo < 10m, rojo > 10m.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#639922", "value": null },
              { "color": "#EF9F27", "value": 300 },
              { "color": "#E24B4A", "value": 600 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "time() - iol_portfolio_last_success_ts",
        "legendFormat": "Hace",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 4,
      "title": "Errores Totales",
      "description": "Errores acumulados de coleccion IOL. Si crece rapido, revisar token/API.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#639922", "value": null },
              { "color": "#EF9F27", "value": 50 },
              { "color": "#E24B4A", "value": 200 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "iol_portfolio_errors_total",
        "legendFormat": "Errores",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 104,
      "title": "Posiciones",
      "type": "row"
    },
    {
      "id": 40,
      "title": "Posiciones IOL - Valor (ARS)",
      "description": "Valor actual en ARS de cada posicion del portfolio IOL.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Valor ARS", "desc": true }],
        "footer": { "show": true, "reducer": ["sum"], "fields": ["Value"] }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "symbol" },
            "properties": [
              { "id": "displayName", "value": "Simbolo" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "type" },
            "properties": [
              { "id": "displayName", "value": "Tipo" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Valor ARS" },
              { "id": "unit", "value": "locale" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "targets": [{
        "expr": "tenazas_iol_position_value_ars{type!=\"\"}",
        "legendFormat": "{{symbol}}",
        "refId": "A",
        "instant": true,
        "format": "table"
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "renameByName": {}
          }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 41,
      "title": "Ganancia Total por Posicion (%)",
      "description": "Ganancia/perdida total de cada posicion vs precio de compra. Rojo = perdida, verde = ganancia.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": -10,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E24B4A", "value": null },
              { "color": "#888780", "value": -0.5 },
              { "color": "#639922", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "expr": "tenazas_iol_position_gain_pct{type!=\"\"}",
        "legendFormat": "{{symbol}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 42,
      "title": "P&L Diario por Posicion (ARS)",
      "description": "Resultado del dia de cada posicion. Permite ver quien aporta y quien resta.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 7 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E24B4A", "value": null },
              { "color": "#888780", "value": -100 },
              { "color": "#639922", "value": 100 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "expr": "tenazas_iol_position_pnl_day_ars{type!=\"\"}",
        "legendFormat": "{{symbol}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 43,
      "title": "Evolucion por Posicion (ARS)",
      "description": "Valor de cada posicion en el tiempo. Permite ver cual crece y cual cae.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "min", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "axisPlacement": "auto",
            "stacking": { "mode": "none" }
          }
        }
      },
      "targets": [{
        "expr": "tenazas_iol_position_value_ars{type!=\"\"}",
        "legendFormat": "{{symbol}}",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 44,
      "title": "Detalle Posiciones",
      "description": "Tabla completa: cantidad, precio actual, PPC, variacion diaria, ganancia total.",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Valor ARS", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Simbolo" },
            "properties": [{ "id": "custom.width", "value": 80 }]
          },
          {
            "matcher": { "id": "byName", "options": "Cantidad" },
            "properties": [{ "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "Precio" },
            "properties": [{ "id": "unit", "value": "locale" }, { "id": "decimals", "value": 2 }]
          },
          {
            "matcher": { "id": "byName", "options": "PPC" },
            "properties": [{ "id": "unit", "value": "locale" }, { "id": "decimals", "value": 2 }]
          },
          {
            "matcher": { "id": "byName", "options": "Var Dia %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#E24B4A", "value": null }, { "color": "#639922", "value": 0 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Gain %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#E24B4A", "value": null }, { "color": "#639922", "value": 0 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "tenazas_iol_position_qty{type!=\"\"}",
          "legendFormat": "{{symbol}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_iol_position_price{type!=\"\"}",
          "legendFormat": "{{symbol}}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_iol_position_ppc{type!=\"\"}",
          "legendFormat": "{{symbol}}",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_iol_position_change_day_pct{type!=\"\"}",
          "legendFormat": "{{symbol}}",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "tenazas_iol_position_gain_pct{type!=\"\"}",
          "legendFormat": "{{symbol}}",
          "refId": "E",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "symbol", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true, "__name__ 4": true, "__name__ 5": true,
              "instance": true, "instance 1": true, "instance 2": true, "instance 3": true, "instance 4": true, "instance 5": true,
              "job": true, "job 1": true, "job 2": true, "job 3": true, "job 4": true, "job 5": true,
              "type": true, "type 1": true, "type 2": true, "type 3": true, "type 4": true, "type 5": true
            },
            "renameByName": {
              "symbol": "Simbolo",
              "Value #A": "Cantidad",
              "Value #B": "Precio",
              "Value #C": "PPC",
              "Value #D": "Var Dia %",
              "Value #E": "Gain %"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 101,
      "title": "Evolucion del Portfolio",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Valor del Portfolio (ARS)",
      "description": "Evolucion del valor total en el tiempo. Linea azul = valor API, linea gris = valor CLI.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "min", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#185FA5" } },
              { "id": "displayName", "value": "Portfolio (API)" }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#888780" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "displayName", "value": "Portfolio (CLI)" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "iol_portfolio_value_ars",
          "legendFormat": "API",
          "refId": "A"
        },
        {
          "expr": "iol_portfolio_total_ars",
          "legendFormat": "CLI",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 11,
      "title": "P&L Diario (ARS)",
      "description": "Resultado del dia en el tiempo. Verde = ganancia, rojo = perdida. Barras para ver claramente cada dia.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 24 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "hidden" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 2,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "pointSize": 5,
            "showPoints": "always",
            "drawStyle": "bars",
            "barAlignment": 0,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E24B4A", "value": null },
              { "color": "#639922", "value": 0 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "expr": "iol_portfolio_pnl_day_ars",
        "legendFormat": "P&L",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 102,
      "title": "P&L y Evolucion",
      "type": "row"
    },
    {
      "id": 20,
      "title": "P&L Actual (ARS)",
      "description": "Resultado no realizado actual del portfolio. Positivo = ganancia vs costo, negativo = perdida.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#E24B4A", "value": null },
              { "color": "#888780", "value": -100 },
              { "color": "#639922", "value": 100 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "iol_portfolio_pnl_day_ars",
        "legendFormat": "P&L",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 21,
      "title": "Evolucion Portfolio (historico)",
      "description": "Valor total del portfolio en el tiempo. Timeseries para ver tendencia y maximos/minimos.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "min", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "smooth"
          },
          "color": { "mode": "fixed", "fixedColor": "#185FA5" }
        }
      },
      "targets": [{
        "expr": "iol_portfolio_value_ars",
        "legendFormat": "Portfolio ARS",
        "refId": "A"
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 103,
      "title": "Salud del Servicio IOL",
      "type": "row"
    },
    {
      "id": 30,
      "title": "Status IOL",
      "description": "OK = datos frescos (<10 min). STALE = sin datos hace >10 min. Revisar token si esta stale.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 44 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "range", "options": { "from": 0, "to": 600, "result": { "text": "OK", "color": "#639922" } } },
            { "type": "range", "options": { "from": 600, "to": 99999999, "result": { "text": "STALE", "color": "#E24B4A" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#639922", "value": null },
              { "color": "#E24B4A", "value": 600 }
            ]
          }
        }
      },
      "targets": [{
        "expr": "time() - iol_portfolio_last_success_ts",
        "legendFormat": "Status",
        "refId": "A",
        "instant": true
      }],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["iol", "portfolio", "finanzas", "tenazas"],
  "templating": {
    "list": [
      {
        "name": "periodo",
        "type": "interval",
        "query": "1d,1w,1M,3M",
        "current": { "value": "1M", "text": "1 mes" },
        "label": "Periodo",
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "America/Argentina/Buenos_Aires",
  "title": "Portfolio IOL - Vista Analista",
  "uid": "iol-portfolio-analista",
  "version": 1
}
