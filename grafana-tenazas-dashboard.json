{
  "dashboard": {
    "id": null,
    "uid": "tenazas-agent",
    "title": "Tenazas Agent",
    "tags": ["tenazas", "agent", "routing", "guardrails"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "id": 1, "title": "Health Score", "type": "gauge",
        "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "runtime_health_score{instance=\"openclaw\"}", "legendFormat": "Health" }],
        "description": "Score 0-100 basado en duracion de ciclo, freezes y restarts. <50=critico, 50-70=degradado, 70-85=warning, 85+=OK",
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 50 },
          { "color": "yellow", "value": 70 }, { "color": "green", "value": 85 }
        ]}}}
      },
      {
        "id": 2, "title": "V2 Decisions", "type": "stat",
        "gridPos": { "h": 6, "w": 3, "x": 4, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_v2_calls_total{instance=\"openclaw\"}", "legendFormat": "V2" }],
        "description": "Total routing decisions via Router V2 (local models). Deberia ser >90% del trafico.",
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]}}}
      },
      {
        "id": 3, "title": "V1 Fallbacks", "type": "stat",
        "gridPos": { "h": 6, "w": 3, "x": 7, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_v1_fallback_from_v2_total{instance=\"openclaw\"}", "legendFormat": "V2→V1" }],
        "description": "V2 fallo y V1 tomo control (backends offline o error). Si crece, investigar HomeLab.",
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ]}}}
      },
      {
        "id": 4, "title": "Cloud Fallbacks", "type": "stat",
        "gridPos": { "h": 6, "w": 3, "x": 10, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_cloud_fallbacks_total{instance=\"openclaw\"}", "legendFormat": "Cloud" }],
        "description": "Routing cayo a Gemini cloud. Debe ser raro. Si crece, todos los backends locales estan offline.",
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ]}}}
      },
      {
        "id": 5, "title": "VRAM Swaps", "type": "stat",
        "gridPos": { "h": 6, "w": 3, "x": 13, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_vram_swaps_total{instance=\"openclaw\"}", "legendFormat": "Swaps" }],
        "description": "Modelos >6GB VRAM en RTX 4050. Ollama offloadea a CPU — funciona pero agrega 5-15s.",
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "orange", "value": 50 }
        ]}}}
      },
      {
        "id": 6, "title": "Guardrail Degradations", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "guardrail_cooldown_total{instance=\"openclaw\"} + guardrail_frequency_total{instance=\"openclaw\"} + guardrail_latency_total{instance=\"openclaw\"} + guardrail_vram_storm_total{instance=\"openclaw\"}", "legendFormat": "Total" }],
        "description": "Guardrails evitaron modelo pesado. Crecimiento lento=normal, spikes=sistema bajo carga.",
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "orange", "value": 20 }
        ]}}}
      },
      {
        "id": 7, "title": "Model Failover", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "model_failover_active{instance=\"openclaw\"}", "legendFormat": "Failover" }],
        "description": "1=usando Ollama (failover de Gemini 429), 0=Gemini primario. Si queda en 1, Gemini tiene rate limit.",
        "fieldConfig": { "defaults": { "unit": "none", "mappings": [
          { "type": "value", "options": { "0": { "text": "Gemini OK", "color": "green" }, "1": { "text": "Ollama Failover", "color": "orange" } }}
        ]}}
      },

      {
        "id": 10, "title": "Routing: V1 vs V2 (tendencia)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Volumen de decisiones de routing. V2 (verde) debe dominar. V1 (azul) = fallback. Cloud (rojo) = ultimo recurso.",
        "targets": [
          { "expr": "router_v2_calls_total{instance=\"openclaw\"}", "legendFormat": "V2 (local)" },
          { "expr": "router_v1_calls_total{instance=\"openclaw\"}", "legendFormat": "V1 (fallback)" },
          { "expr": "router_v1_fallback_from_v2_total{instance=\"openclaw\"}", "legendFormat": "V2→V1" },
          { "expr": "router_cloud_fallbacks_total{instance=\"openclaw\"}", "legendFormat": "Cloud" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "V2 (local)" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "V1 (fallback)" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "V2→V1" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Cloud" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 11, "title": "Routing: Distribucion por rol", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Que roles se usan. Fast=mayoria, reason=analisis, heavy=critico (caro), code=generacion, vision=imagenes.",
        "targets": [
          { "expr": "router_v2_role_fast_total{instance=\"openclaw\"}", "legendFormat": "fast (7b)" },
          { "expr": "router_v2_role_reason_total{instance=\"openclaw\"}", "legendFormat": "reason (14b)" },
          { "expr": "router_v2_role_heavy_total{instance=\"openclaw\"}", "legendFormat": "heavy (32b)" },
          { "expr": "router_v2_role_code_total{instance=\"openclaw\"}", "legendFormat": "code (14b)" },
          { "expr": "router_v2_role_vision_total{instance=\"openclaw\"}", "legendFormat": "vision (7b)" },
          { "expr": "router_v2_role_embed_total{instance=\"openclaw\"}", "legendFormat": "embed" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" } }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "fast (7b)" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "reason (14b)" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "heavy (32b)" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "code (14b)" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "vision (7b)" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "embed" }, "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-blue", "mode": "fixed" } }] }
          ]
        }
      },

      {
        "id": 20, "title": "Latencia de decision de routing", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Tiempo para decidir modelo (sin contar inferencia). <1s=normal, 1-5s=backend lento, >5s=problema de red.",
        "targets": [
          { "expr": "router_last_decision_latency_seconds{instance=\"openclaw\"}", "legendFormat": "Decision latency" }
        ],
        "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5, "showPoints": "auto" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }
          ]}}}
      },
      {
        "id": 21, "title": "Fallbacks internos V2 + VRAM swaps", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "V2 internal: modelo primario del rol no disponible, uso alternativa. VRAM swap: modelo >6GB cargado (lento). Cloud: ultimo recurso.",
        "targets": [
          { "expr": "router_v2_internal_fallbacks_total{instance=\"openclaw\"}", "legendFormat": "V2 internal fallbacks" },
          { "expr": "router_vram_swaps_total{instance=\"openclaw\"}", "legendFormat": "VRAM swaps" },
          { "expr": "router_cloud_fallbacks_total{instance=\"openclaw\"}", "legendFormat": "Cloud fallbacks" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "V2 internal fallbacks" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "VRAM swaps" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Cloud fallbacks" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },

      {
        "id": 30, "title": "Guardrails: degradaciones por motivo", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Cooldown: modelo pesado usado <120s atras. Frequency: >3 heavy/10min. Latency: ultima inferencia >30s. VRAM storm: >3 swaps/10min.",
        "targets": [
          { "expr": "guardrail_cooldown_total{instance=\"openclaw\"}", "legendFormat": "Cooldown (120s)" },
          { "expr": "guardrail_frequency_total{instance=\"openclaw\"}", "legendFormat": "Frequency (3/10min)" },
          { "expr": "guardrail_latency_total{instance=\"openclaw\"}", "legendFormat": "Latency (>30s)" },
          { "expr": "guardrail_vram_storm_total{instance=\"openclaw\"}", "legendFormat": "VRAM storm (3+swaps)" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Cooldown (120s)" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Frequency (3/10min)" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Latency (>30s)" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "VRAM storm (3+swaps)" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 31, "title": "Runtime: ciclos y salud", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Ciclos del runtime cron (cada 5min). Duracion <30s=verde, 30-60s=warning, >60s=critico. Health score 0-100.",
        "targets": [
          { "expr": "runtime_last_duration_seconds{instance=\"openclaw\"}", "legendFormat": "Cycle duration" },
          { "expr": "runtime_health_score{instance=\"openclaw\"}", "legendFormat": "Health score" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Cycle duration" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Health score" }, "properties": [{ "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
          ]
        }
      },

      {
        "id": 40, "title": "Ollama: failures y failover", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Ollama failures: HomeLab no responde. Failover: 1=Gemini rate-limited, usando Ollama. Runtime failures: ciclo crasheo.",
        "targets": [
          { "expr": "ollama_failures_total{instance=\"openclaw\"}", "legendFormat": "Ollama failures" },
          { "expr": "model_failover_active{instance=\"openclaw\"}", "legendFormat": "Failover active" },
          { "expr": "runtime_failures_total{instance=\"openclaw\"}", "legendFormat": "Runtime failures" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Ollama failures" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Failover active" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Runtime failures" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 41, "title": "Runtime: ciclos totales y failures", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "description": "Runs=ciclos completados (cada 5min). Failures=ciclos con error. Freezes=ciclo se congelo >30s.",
        "targets": [
          { "expr": "runtime_runs_total{instance=\"openclaw\"}", "legendFormat": "Runs" },
          { "expr": "runtime_failures_total{instance=\"openclaw\"}", "legendFormat": "Failures" },
          { "expr": "runtime_freeze_detected{instance=\"openclaw\"}", "legendFormat": "Freezes" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Runs" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Failures" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Freezes" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
          ]
        }
      }
    ],
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [
      { "title": "Tenazas Infra", "url": "/d/tenazas-runtime", "type": "link", "tooltip": "Dashboard de infraestructura general" }
    ],
    "templating": { "list": [] },
    "annotations": { "list": [] }
  },
  "overwrite": true
}
