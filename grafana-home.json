{
  "dashboard": {
    "uid": "tenazas-home",
    "title": "Tenazas Control Tower",
    "tags": [
      "tenazas",
      "home"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "panels": [
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 100,
        "title": "Estado Global",
        "type": "row"
      },
      {
        "id": 1,
        "title": "System Health",
        "type": "stat",
        "datasource": {
          "uid": "afhjgavdgav40d",
          "type": "prometheus"
        },
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 1
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "range",
                "options": {
                  "from": 80,
                  "to": 100,
                  "result": {
                    "text": "OK",
                    "color": "green"
                  }
                }
              },
              {
                "type": "range",
                "options": {
                  "from": 50,
                  "to": 79.99,
                  "result": {
                    "text": "DEGRADED",
                    "color": "yellow"
                  }
                }
              },
              {
                "type": "range",
                "options": {
                  "from": 0,
                  "to": 49.99,
                  "result": {
                    "text": "DOWN",
                    "color": "red"
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "green",
                  "value": 80
                }
              ]
            },
            "color": {
              "mode": "fixed"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "graphMode": "none",
          "colorMode": "background",
          "textMode": "auto",
          "justifyMode": "auto"
        },
        "targets": [
          {
            "datasource": {
              "uid": "afhjgavdgav40d",
              "type": "prometheus"
            },
            "expr": "runtime_health_score",
            "refId": "A"
          }
        ]
      },
