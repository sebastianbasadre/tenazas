{
  "dashboard": {
    "id": null,
    "uid": "tenazas-device-discovery",
    "title": "Tenazas Device Discovery",
    "tags": ["tenazas", "network", "devices"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "30s",
    "time": { "from": "now-24h", "to": "now" },
    "schemaVersion": 39,
    "version": 2,
    "editable": true,
    "graphTooltip": 1,
    "templating": { "list": [] },
    "annotations": { "list": [] },
    "panels": [
      {
        "id": 100,
        "title": "Red LAN",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "id": 1,
        "title": "Total",
        "description": "Dispositivos en inventario",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_total{instance=\"openclaw\"}", "legendFormat": "Total" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 10 },
                { "color": "green", "value": 20 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Online",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_online{instance=\"openclaw\"}", "legendFormat": "Online" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
        }
      },
      {
        "id": 3,
        "title": "Missing",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_missing{instance=\"openclaw\"}", "legendFormat": "Missing" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]}
          }
        }
      },
      {
        "id": 4,
        "title": "Clasificados",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_classified{instance=\"openclaw\"}", "legendFormat": "Classified" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
            { "color": "yellow", "value": null },
            { "color": "green", "value": 10 }
          ]}}
        }
      },
      {
        "id": 5,
        "title": "Controlables",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_controllable{instance=\"openclaw\"}", "legendFormat": "Controllable" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
        }
      },
      {
        "id": 6,
        "title": "Deco WiFi",
        "description": "Clientes WiFi conectados al mesh Deco",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_deco_clients_total{instance=\"openclaw\"}", "legendFormat": "WiFi" }
        ],
        "fieldConfig": {
          "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
            { "color": "purple", "value": null }
          ]}}
        }
      },
      {
        "id": 200,
        "title": "Inventario de Dispositivos",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
        "collapsed": false
      },
      {
        "id": 11,
        "title": "Dispositivos",
        "description": "Tabla completa del inventario de red",
        "type": "table",
        "gridPos": { "h": 14, "w": 24, "x": 0, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          {
            "expr": "tenazas_device_info{instance=\"openclaw\"}",
            "legendFormat": "",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "Value": true,
                "__name__": true,
                "instance": true,
                "job": true
              },
              "indexByName": {
                "ip": 0,
                "name": 1,
                "vendor": 2,
                "category": 3,
                "mac": 4,
                "control": 5
              },
              "renameByName": {
                "ip": "IP",
                "name": "Nombre",
                "vendor": "Vendor",
                "category": "Categoria",
                "mac": "MAC",
                "control": "Control"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "left",
              "filterable": true
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "IP" },
              "properties": [{ "id": "custom.width", "value": 140 }]
            },
            {
              "matcher": { "id": "byName", "options": "Nombre" },
              "properties": [{ "id": "custom.width", "value": 200 }]
            },
            {
              "matcher": { "id": "byName", "options": "Categoria" },
              "properties": [
                { "id": "custom.width", "value": 120 },
                {
                  "id": "mappings",
                  "value": [
                    { "type": "value", "options": { "server": { "text": "Server", "color": "blue" } } },
                    { "type": "value", "options": { "network": { "text": "Network", "color": "yellow" } } },
                    { "type": "value", "options": { "smart_home": { "text": "Smart Home", "color": "green" } } },
                    { "type": "value", "options": { "display": { "text": "Display", "color": "purple" } } },
                    { "type": "value", "options": { "iot": { "text": "IoT", "color": "orange" } } },
                    { "type": "value", "options": { "phone": { "text": "Phone", "color": "cyan" } } },
                    { "type": "value", "options": { "speaker": { "text": "Speaker", "color": "light-green" } } }
                  ]
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "MAC" },
              "properties": [{ "id": "custom.width", "value": 160 }]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [{ "displayName": "IP", "desc": false }],
          "footer": { "show": true, "reducer": ["count"], "countRows": true }
        }
      },
      {
        "id": 300,
        "title": "Distribucion",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
        "collapsed": false
      },
      {
        "id": 7,
        "title": "Por Categoria",
        "type": "piechart",
        "gridPos": { "h": 9, "w": 8, "x": 0, "y": 21 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_total{instance=\"openclaw\"} - ignoring() device_discovery_by_category{instance=\"openclaw\",category=\"unknown\"}", "legendFormat": "Classified", "hide": true },
          { "expr": "device_discovery_by_category{instance=\"openclaw\"}", "legendFormat": "{{category}}" }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "pieType": "donut",
          "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
        },
        "fieldConfig": {
          "defaults": { "unit": "short" },
          "overrides": [
            { "matcher": { "id": "byName", "options": "server" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "smart_home" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "display" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "iot" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "network" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "unknown" }, "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-red", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "client" }, "properties": [{ "id": "color", "value": { "fixedColor": "cyan", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "phone" }, "properties": [{ "id": "color", "value": { "fixedColor": "light-blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "speaker" }, "properties": [{ "id": "color", "value": { "fixedColor": "light-green", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 8,
        "title": "Por Vendor",
        "type": "bargauge",
        "gridPos": { "h": 9, "w": 8, "x": 8, "y": 21 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_by_vendor{instance=\"openclaw\"} > 0", "legendFormat": "{{vendor}}" }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short", "min": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 2 },
              { "color": "yellow", "value": 5 }
            ]}
          }
        }
      },
      {
        "id": 12,
        "title": "WiFi vs Ethernet",
        "description": "Conexiones por tipo (requiere Deco API)",
        "type": "piechart",
        "gridPos": { "h": 9, "w": 8, "x": 16, "y": 21 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_deco_by_connection{instance=\"openclaw\"}", "legendFormat": "{{connection_type}}" }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "pieType": "donut",
          "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
        },
        "fieldConfig": {
          "defaults": { "unit": "short" },
          "overrides": [
            { "matcher": { "id": "byName", "options": "wifi_5g" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "wifi_2.4g" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "ethernet" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 400,
        "title": "Historico",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
        "collapsed": false
      },
      {
        "id": 9,
        "title": "Dispositivos (historico)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_devices_total{instance=\"openclaw\"}", "legendFormat": "Total" },
          { "expr": "tenazas_devices_online{instance=\"openclaw\"}", "legendFormat": "Online" },
          { "expr": "tenazas_devices_missing{instance=\"openclaw\"}", "legendFormat": "Missing" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "pointSize": 5, "showPoints": "auto" }
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Total" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Online" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Missing" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 10,
        "title": "Categorias (historico)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_by_category{instance=\"openclaw\",category!=\"unknown\"}", "legendFormat": "{{category}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } }
          }
        }
      }
    ]
  },
  "overwrite": true
}
