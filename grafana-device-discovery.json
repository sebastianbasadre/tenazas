{
  "dashboard": {
    "id": null,
    "uid": "tenazas-device-discovery",
    "title": "Tenazas Device Discovery",
    "tags": ["tenazas", "network", "devices"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "30s",
    "time": { "from": "now-24h", "to": "now" },
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "graphTooltip": 1,
    "templating": { "list": [] },
    "annotations": { "list": [] },
    "panels": [
      {
        "id": 100,
        "title": "Red LAN",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "id": 1,
        "title": "Total Dispositivos",
        "description": "Dispositivos en el inventario persistente",
        "type": "stat",
        "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_total{instance=\"openclaw\"}", "legendFormat": "Total" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 10 },
                { "color": "green", "value": 20 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Online",
        "description": "Dispositivos detectados en el ultimo scan",
        "type": "stat",
        "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_online{instance=\"openclaw\"}", "legendFormat": "Online" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Missing",
        "description": "Dispositivos que desaparecieron del ultimo scan",
        "type": "stat",
        "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_missing{instance=\"openclaw\"}", "legendFormat": "Missing" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "orange", "value": 3 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Clasificados",
        "description": "Dispositivos con categoria conocida (no unknown)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_classified{instance=\"openclaw\"}", "legendFormat": "Classified" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "yellow", "value": null },
                { "color": "green", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Controlables",
        "description": "Dispositivos con metodo de control (ssh/http/mqtt/websocket)",
        "type": "stat",
        "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_controllable{instance=\"openclaw\"}", "legendFormat": "Controllable" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "blue", "value": null }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Ultimo Scan",
        "description": "Tiempo desde el ultimo scan exitoso",
        "type": "stat",
        "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "time() - device_discovery_last_scan_ts{instance=\"openclaw\"}", "legendFormat": "Ago" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 3600 },
                { "color": "orange", "value": 7200 },
                { "color": "red", "value": 86400 }
              ]
            }
          }
        }
      },
      {
        "id": 200,
        "title": "Distribucion",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
        "collapsed": false
      },
      {
        "id": 7,
        "title": "Dispositivos por Categoria",
        "description": "server, network, smart_home, display, iot, client, camera, printer, unknown",
        "type": "piechart",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 7 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_by_category{instance=\"openclaw\"}", "legendFormat": "{{category}}" }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "pieType": "donut",
          "tooltip": { "mode": "single" },
          "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "server" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "smart_home" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "display" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "iot" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "client" }, "properties": [{ "id": "color", "value": { "fixedColor": "cyan", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "network" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "unknown" }, "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 8,
        "title": "Dispositivos por Vendor",
        "description": "Fabricante identificado por MAC OUI lookup",
        "type": "bargauge",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 7 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_by_vendor{instance=\"openclaw\"} > 0", "legendFormat": "{{vendor}}" }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "minVizWidth": 0,
          "minVizHeight": 10
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "blue", "value": null },
                { "color": "green", "value": 2 },
                { "color": "yellow", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 300,
        "title": "Historico",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
        "collapsed": false
      },
      {
        "id": 9,
        "title": "Total Dispositivos (historico)",
        "description": "Evolucion del numero de dispositivos en la red",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_total{instance=\"openclaw\"}", "legendFormat": "Total" },
          { "expr": "device_discovery_online{instance=\"openclaw\"}", "legendFormat": "Online" },
          { "expr": "device_discovery_missing{instance=\"openclaw\"}", "legendFormat": "Missing" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 15,
              "pointSize": 5,
              "showPoints": "auto"
            }
          },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Total" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Online" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Missing" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 10,
        "title": "Categorias (historico)",
        "description": "Evolucion de dispositivos por categoria",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "device_discovery_by_category{instance=\"openclaw\",category!=\"unknown\"}", "legendFormat": "{{category}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 50,
              "stacking": { "mode": "normal" }
            }
          }
        }
      }
    ]
  },
  "overwrite": true
}
