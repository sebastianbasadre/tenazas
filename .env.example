TZ=America/Buenos_Aires
HOST_DOCKER_GID=65536

# Required for Grafana.
GF_SECURITY_ADMIN_PASSWORD=change-me

# Pin infrastructure images explicitly. Update intentionally.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.0.2
SEARXNG_IMAGE=searxng/searxng@sha256:3aed6b4bfb4e6a2b3b94c890dafb3f35cb2588493b83818434aa260e8bdeb4d4
OPENCLAW_VERSION=2026.6.1
HIMALAYA_VERSION=v1.2.0

# Job runner must not use a shared default token.
TENAZAS_JOB_RUNNER_HOST=127.0.0.1
TENAZAS_JOB_RUNNER_PORT=18891
TENAZAS_JOB_RUNNER_TOKEN=replace-with-random-32-byte-token
ENABLE_RUNTIME_SCHEDULER=true
TENAZAS_ADMIN_BIND_IP=192.168.2.2
N8N_EDITOR_BASE_URL=https://192.168.2.2:5679
WEBHOOK_URL=https://192.168.2.2:5679/

OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_TELEGRAM_CHAT_ID=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_BASE=
OLLAMA_API_KEY=
BINANCE_API_KEY=
BINANCE_SECRET=
HUE_API_KEY=
GOG_KEYRING_PASSWORD=
GOG_ACCOUNT=

TENAZAS_LAN_SUBNET=192.168.2.0/24
TENAZAS_ROUTER_IP=192.168.2.1
TENAZAS_NAS_IP=192.168.2.2
TENAZAS_NAS_BACKUP_IP=192.168.2.3
TENAZAS_HOMELAB_IP=192.168.2.6
TENAZAS_HOMELAB_USER=sbasadre
TENAZAS_OLLAMA_UPSTREAM_URL=http://192.168.2.6:11434
# Local automation has zero cloud inference spend by default.
TENAZAS_ALLOW_CLOUD=false
