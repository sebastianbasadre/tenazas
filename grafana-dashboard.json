{
  "dashboard": {
    "id": null,
    "uid": "tenazas-runtime",
    "title": "Tenazas Runtime",
    "tags": ["tenazas", "runtime", "infrastructure"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "panels": [
      {
        "id": 1, "title": "Health Score", "type": "gauge",
        "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "runtime_health_score", "legendFormat": "Health" }],
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 50 },
          { "color": "yellow", "value": 70 }, { "color": "green", "value": 85 }
        ]}}}
      },
      {
        "id": 2, "title": "Ciclos completados", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "runtime_runs_total", "legendFormat": "Total runs" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]}}}
      },
      {
        "id": 3, "title": "Failures", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "runtime_failures_total", "legendFormat": "Failures" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 }
        ]}}}
      },
      {
        "id": 4, "title": "Container Restarts", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "container_restarts_total", "legendFormat": "Restarts" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 10 }
        ]}}}
      },
      {
        "id": 5, "title": "VPN Disconnects", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "vpn_disconnects_total", "legendFormat": "VPN drops" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ]}}}
      },
      {
        "id": 6, "title": "Freezes / Watchdog", "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "runtime_freeze_detected", "legendFormat": "Freezes" },
          { "expr": "runtime_watchdog_triggered", "legendFormat": "Watchdog" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 }
        ]}}}
      },
      {
        "id": 10, "title": "Duracion del ciclo", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "runtime_last_duration_seconds", "legendFormat": "Last duration" }],
        "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5, "showPoints": "auto" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 }
          ]}}}
      },
      {
        "id": 11, "title": "Health Score (historia)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "runtime_health_score", "legendFormat": "Health" }],
        "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "gradientMode": "scheme" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 50 },
            { "color": "yellow", "value": 70 }, { "color": "green", "value": 85 }
          ]},
          "color": { "mode": "thresholds" }
        }}
      },
      {
        "id": 20, "title": "Ciclos totales (historia)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "runtime_runs_total", "legendFormat": "Runs" },
          { "expr": "runtime_failures_total", "legendFormat": "Failures" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }}}
      },
      {
        "id": 21, "title": "Ollama Failures", "type": "stat",
        "gridPos": { "h": 8, "w": 4, "x": 12, "y": 14 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "ollama_failures_total", "legendFormat": "Ollama" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }
        ]}}}
      },
      {
        "id": 30, "title": "Eventos de infraestructura", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "container_restarts_total", "legendFormat": "Container restarts" },
          { "expr": "vpn_disconnects_total", "legendFormat": "VPN disconnects" },
          { "expr": "ollama_failures_total", "legendFormat": "Ollama failures" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Container restarts" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "VPN disconnects" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Ollama failures" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 31, "title": "Freezes y Watchdog (historia)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "runtime_freeze_detected", "legendFormat": "Freeze detected" },
          { "expr": "runtime_watchdog_triggered", "legendFormat": "Watchdog triggered" },
          { "expr": "runtime_failures_total", "legendFormat": "Runtime failures" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Freeze detected" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Watchdog triggered" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Runtime failures" }, "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 40, "title": "Router: V1 vs V2", "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "router_v2_calls_total", "legendFormat": "V2 calls" },
          { "expr": "router_v1_calls_total", "legendFormat": "V1 calls" },
          { "expr": "router_v1_fallback_from_v2_total", "legendFormat": "V2→V1 fallback" },
          { "expr": "router_cloud_fallbacks_total", "legendFormat": "Cloud fallback" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "V2 calls" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "V1 calls" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "V2→V1 fallback" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Cloud fallback" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 41, "title": "Router: Distribución por rol", "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "router_v2_role_fast_total", "legendFormat": "fast" },
          { "expr": "router_v2_role_reason_total", "legendFormat": "reason" },
          { "expr": "router_v2_role_heavy_total", "legendFormat": "heavy" },
          { "expr": "router_v2_role_code_total", "legendFormat": "code" },
          { "expr": "router_v2_role_vision_total", "legendFormat": "vision" },
          { "expr": "router_v2_role_embed_total", "legendFormat": "embed" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" } }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "fast" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "reason" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "heavy" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "code" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "vision" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "embed" }, "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-blue", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 42, "title": "Router: Fallbacks y VRAM swaps", "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "router_v2_internal_fallbacks_total", "legendFormat": "V2 internal fallbacks" },
          { "expr": "router_vram_swaps_total", "legendFormat": "VRAM swaps" },
          { "expr": "router_cloud_fallbacks_total", "legendFormat": "Cloud fallbacks" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "V2 internal fallbacks" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "VRAM swaps" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Cloud fallbacks" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 43, "title": "Router: Latencia de decisión", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "router_last_decision_latency_seconds", "legendFormat": "Decision latency" }
        ],
        "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5, "showPoints": "auto" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }
          ]}}}
      },
      {
        "id": 44, "title": "Cloud Fallbacks", "type": "stat",
        "gridPos": { "h": 8, "w": 4, "x": 12, "y": 38 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_cloud_fallbacks_total", "legendFormat": "Cloud" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ]},
          "description": "Times routing fell through to Gemini cloud because all local backends were offline. This should be rare — investigate if this grows."
        }}
      },
      {
        "id": 45, "title": "VRAM Swaps", "type": "stat",
        "gridPos": { "h": 8, "w": 4, "x": 16, "y": 38 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_vram_swaps_total", "legendFormat": "Swaps" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "orange", "value": 50 }
        ]},
          "description": "Models exceeding 6GB VRAM on RTX 4050. Ollama offloads to CPU RAM — works but adds 5-15s latency."
        }}
      },
      {
        "id": 46, "title": "V2→V1 Fallbacks", "type": "stat",
        "gridPos": { "h": 8, "w": 4, "x": 20, "y": 38 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "router_v1_fallback_from_v2_total", "legendFormat": "V2→V1" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }
        ]},
          "description": "V2 failed (all Ollama backends offline or error) and V1 took over with Gemini cloud."
        }}
      },
      {
        "id": 60, "title": "Guardrails: Degradaciones por motivo", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "guardrail_cooldown_total", "legendFormat": "Cooldown (120s)" },
          { "expr": "guardrail_frequency_total", "legendFormat": "Frequency (3/10min)" },
          { "expr": "guardrail_latency_total", "legendFormat": "Latency (>30s)" },
          { "expr": "guardrail_vram_storm_total", "legendFormat": "VRAM storm (3+swaps)" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "Cooldown (120s)" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Frequency (3/10min)" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Latency (>30s)" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "VRAM storm (3+swaps)" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 61, "title": "Heavy evitado (total)", "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 46 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "guardrail_cooldown_total + guardrail_frequency_total + guardrail_latency_total + guardrail_vram_storm_total", "legendFormat": "Total degradaciones" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "orange", "value": 20 }
        ]},
          "description": "Total times guardrails prevented a heavy model from being used. Growing slowly is normal — spikes may indicate system under load."
        }}
      },
      {
        "id": 62, "title": "Inference Latency (heavy)", "type": "timeseries",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 46 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "router_last_decision_latency_seconds", "legendFormat": "Router decision" }
        ],
        "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 30 }
          ]}}}
      },
      {
        "id": 50, "title": "Memoria del proceso", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "process_resident_memory_bytes", "legendFormat": "RSS" },
          { "expr": "process_virtual_memory_bytes", "legendFormat": "Virtual" }
        ],
        "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }},
          "overrides": [
            { "matcher": { "id": "byName", "options": "RSS" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Virtual" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
          ]
        }
      },
      {
        "id": 51, "title": "CPU del proceso", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [{ "expr": "rate(process_cpu_seconds_total[5m])", "legendFormat": "CPU usage" }],
        "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }}
      }
    ],
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "templating": { "list": [] },
    "annotations": { "list": [] }
  },
  "overwrite": true
}
