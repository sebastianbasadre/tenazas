{
  "dashboard": {
    "uid": "tenazas-api-calls",
    "title": "Tenazas API Calls",
    "tags": ["tenazas", "api", "observability"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "1m",
    "time": { "from": "now-24h", "to": "now" },
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "annotations": { "list": [] },
    "templating": { "list": [] },
    "links": [],
    "panels": [
      {
        "type": "row", "id": 1, "title": "☁️ Gemini API",
        "collapsed": false, "panels": [],
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "timeseries", "id": 10,
        "title": "Gemini Calls / hora",
        "fieldConfig": {
          "defaults": {
            "unit": "none", "decimals": 0,
            "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "pointSize": 5, "showPoints": "auto" }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Errors" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "Rate Limited" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
            }
          ]
        },
        "targets": [
          { "expr": "sum by (model)(rate(tenazas_api_calls_total{service=\"gemini\",status=\"ok\"}[1h])*3600)", "legendFormat": "{{model}}" },
          { "expr": "sum(rate(tenazas_api_calls_total{service=\"gemini\",status=\"error\"}[1h])*3600)", "legendFormat": "Errors" },
          { "expr": "sum(rate(tenazas_api_calls_total{service=\"gemini\",status=\"rate_limit\"}[1h])*3600)", "legendFormat": "Rate Limited" }
        ],
        "gridPos": { "h": 7, "w": 10, "x": 0, "y": 1 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "stat", "id": 11,
        "title": "Gemini — Total este mes",
        "fieldConfig": {
          "defaults": {
            "unit": "none", "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
          }
        },
        "targets": [
          { "expr": "tenazas_api_calls_monthly{service=\"gemini\"}", "legendFormat": "Calls" }
        ],
        "gridPos": { "h": 7, "w": 6, "x": 10, "y": 1 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "piechart", "id": 12,
        "title": "Gemini — Distribución por modelo",
        "fieldConfig": {
          "defaults": { "unit": "none" }
        },
        "options": { "pieType": "donut", "legend": { "displayMode": "list", "placement": "right" } },
        "targets": [
          { "expr": "sum by (model)(tenazas_api_calls_total{service=\"gemini\",status=\"ok\"})", "legendFormat": "{{model}}" }
        ],
        "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 }
      },
      {
        "type": "row", "id": 2, "title": "📈 IOL InvertirOnline API",
        "collapsed": false, "panels": [],
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "gauge", "id": 20,
        "title": "Cuota mensual (límite 25.000)",
        "fieldConfig": {
          "defaults": {
            "min": 0, "max": 1, "unit": "percentunit", "decimals": 1,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]}
          }
        },
        "targets": [
          { "expr": "tenazas_iol_quota_used", "legendFormat": "Quota" }
        ],
        "gridPos": { "h": 7, "w": 6, "x": 0, "y": 9 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "stat", "id": 21,
        "title": "Calls restantes",
        "fieldConfig": {
          "defaults": {
            "unit": "none", "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 2500 },
              { "color": "yellow", "value": 5000 },
              { "color": "green", "value": 10000 }
            ]}
          }
        },
        "targets": [
          { "expr": "tenazas_iol_quota_remaining", "legendFormat": "Remaining" }
        ],
        "gridPos": { "h": 7, "w": 6, "x": 6, "y": 9 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "stat", "id": 22,
        "title": "IOL — Total este mes",
        "fieldConfig": {
          "defaults": {
            "unit": "none", "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
          }
        },
        "targets": [
          { "expr": "tenazas_api_calls_monthly{service=\"iol\"}", "legendFormat": "Calls" }
        ],
        "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "timeseries", "id": 23,
        "title": "IOL Calls por endpoint / hora",
        "fieldConfig": {
          "defaults": {
            "unit": "none", "decimals": 0,
            "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }
          }
        },
        "targets": [
          { "expr": "sum by (endpoint)(rate(tenazas_api_calls_total{service=\"iol\"}[1h])*3600)", "legendFormat": "{{endpoint}}" }
        ],
        "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 }
      },
      {
        "type": "row", "id": 3, "title": "🔄 Todos los servicios",
        "collapsed": false, "panels": [],
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
      },
      {
        "datasource": { "type": "prometheus", "uid": "afhjgavdgav40d" },
        "type": "timeseries", "id": 30,
        "title": "API Calls — Todos los servicios",
        "fieldConfig": {
          "defaults": {
            "unit": "none", "decimals": 0,
            "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Gemini OK" },
              "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "IOL OK" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "Gemini Errors" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "IOL Errors" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
            }
          ]
        },
        "targets": [
          { "expr": "sum(rate(tenazas_api_calls_total{service=\"gemini\",status=\"ok\"}[1h])*3600)", "legendFormat": "Gemini OK" },
          { "expr": "sum(rate(tenazas_api_calls_total{service=\"iol\",status=\"ok\"}[1h])*3600)", "legendFormat": "IOL OK" },
          { "expr": "sum(rate(tenazas_api_calls_total{service=\"gemini\",status!=\"ok\"}[1h])*3600)", "legendFormat": "Gemini Errors" },
          { "expr": "sum(rate(tenazas_api_calls_total{service=\"iol\",status!=\"ok\"}[1h])*3600)", "legendFormat": "IOL Errors" }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 }
      }
    ]
  },
  "overwrite": true,
  "folderUid": ""
}
