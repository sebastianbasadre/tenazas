{
  "dashboard": {
    "id": null,
    "uid": "tenazas-homelab",
    "title": "Tenazas HomeLab",
    "tags": ["tenazas", "homelab", "infra"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "30s",
    "time": { "from": "now-3h", "to": "now" },
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "graphTooltip": 1,
    "panels": [

      { "id": 100, "title": "HomeLab Overview \u2014 i7-12700KF / RTX 3090 / 64GB", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

      {
        "id": 1, "title": "Uptime", "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "time() - windows_system_system_up_time{instance=\"homelab\"}", "legendFormat": "Uptime" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "dtdurations", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 3600 },
            { "color": "green", "value": 86400 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none", "colorMode": "value", "textMode": "value" }
      },
      {
        "id": 2, "title": "CPU Usage", "type": "gauge",
        "description": "i7-12700KF \u2014 12 cores / 20 threads",
        "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (avg(rate(windows_cpu_time_total{instance=\"homelab\",mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU%" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "orange", "value": 80 },
            { "color": "red", "value": 95 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false }
      },
      {
        "id": 3, "title": "RAM Used", "type": "gauge",
        "description": "64 GB DDR4",
        "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (windows_memory_available_bytes{instance=\"homelab\"} / windows_memory_physical_total_bytes{instance=\"homelab\"} * 100)", "legendFormat": "RAM%" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 85 },
            { "color": "red", "value": 95 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false }
      },
      {
        "id": 4, "title": "RAM Free", "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "windows_memory_available_bytes{instance=\"homelab\"}", "legendFormat": "Available" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "bytes", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 4294967296 },
            { "color": "green", "value": 8589934592 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area", "colorMode": "value", "textMode": "value" }
      },
      {
        "id": 5, "title": "Disk C:", "type": "gauge",
        "description": "System drive (580 GB)",
        "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (windows_logical_disk_free_bytes{instance=\"homelab\",volume=\"C:\"} / windows_logical_disk_size_bytes{instance=\"homelab\",volume=\"C:\"} * 100)", "legendFormat": "C: used" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 85 },
            { "color": "red", "value": 95 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false }
      },
      {
        "id": 6, "title": "Disk D:", "type": "gauge",
        "description": "Data drive / HF cache (419 GB)",
        "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (windows_logical_disk_free_bytes{instance=\"homelab\",volume=\"D:\"} / windows_logical_disk_size_bytes{instance=\"homelab\",volume=\"D:\"} * 100)", "legendFormat": "D: used" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 85 },
            { "color": "red", "value": 95 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false }
      },
      {
        "id": 7, "title": "Ollama GPU", "type": "stat",
        "description": "Ollama en 192.168.2.6:11434",
        "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "ollama_gpu_up", "legendFormat": "Ollama" }
        ],
        "fieldConfig": { "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "ONLINE", "color": "green" }, "0": { "text": "OFFLINE", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "green", "value": 1 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none", "colorMode": "background", "textMode": "value" }
      },
      {
        "id": 8, "title": "Processes", "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "windows_system_processes{instance=\"homelab\"}", "legendFormat": "Processes" },
          { "expr": "windows_system_threads{instance=\"homelab\"}", "legendFormat": "Threads" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none", "colorMode": "value", "textMode": "value_and_name" }
      },

      { "id": 200, "title": "CPU", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false },

      {
        "id": 20, "title": "CPU Usage %", "type": "timeseries",
        "description": "Total CPU usage across all 20 threads",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (avg(rate(windows_cpu_time_total{instance=\"homelab\",mode=\"idle\"}[2m])) * 100)", "legendFormat": "Total CPU%" },
          { "expr": "avg(rate(windows_cpu_time_total{instance=\"homelab\",mode=\"user\"}[2m])) * 100", "legendFormat": "User" },
          { "expr": "avg(rate(windows_cpu_time_total{instance=\"homelab\",mode=\"privileged\"}[2m])) * 100", "legendFormat": "Kernel" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "spanNulls": true, "lineWidth": 2 }
        },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Total CPU%" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "User" },
              "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
                { "id": "custom.lineWidth", "value": 1 }, { "id": "custom.fillOpacity", "value": 5 }] },
            { "matcher": { "id": "byName", "options": "Kernel" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
                { "id": "custom.lineWidth", "value": 1 }, { "id": "custom.fillOpacity", "value": 5 }] }
          ]
        },
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] } }
      },
      {
        "id": 21, "title": "CPU per Core", "type": "timeseries",
        "description": "Per-core usage (20 threads)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (rate(windows_cpu_time_total{instance=\"homelab\",mode=\"idle\"}[2m]) * 100)", "legendFormat": "Core {{core}}" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 0, "spanNulls": true, "lineWidth": 1 },
          "color": { "mode": "palette-classic" }
        }},
        "options": { "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "hidden" } }
      },

      { "id": 300, "title": "Memory", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false },

      {
        "id": 30, "title": "RAM Usage", "type": "timeseries",
        "description": "Physical memory: total, used, available",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "windows_memory_physical_total_bytes{instance=\"homelab\"} - windows_memory_available_bytes{instance=\"homelab\"}", "legendFormat": "Used" },
          { "expr": "windows_memory_available_bytes{instance=\"homelab\"}", "legendFormat": "Available" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "bytes", "decimals": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 30, "spanNulls": true, "lineWidth": 2,
            "stacking": { "mode": "normal" } }
        },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Used" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Available" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
          ]
        },
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
      },
      {
        "id": 31, "title": "Page Faults / sec", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_memory_page_faults_total{instance=\"homelab\"}[2m])", "legendFormat": "Page Faults/s" },
          { "expr": "rate(windows_memory_swap_page_operations_total{instance=\"homelab\"}[2m])", "legendFormat": "Swap Pages/s" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "short", "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "spanNulls": true }
        },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Swap Pages/s" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
          ]
        },
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
      },

      { "id": 400, "title": "Disk", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "collapsed": false },

      {
        "id": 40, "title": "Disk Space", "type": "bargauge",
        "description": "Free vs total per volume",
        "gridPos": { "h": 5, "w": 8, "x": 0, "y": 24 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "100 - (windows_logical_disk_free_bytes{instance=\"homelab\",volume=~\"C:|D:\"} / windows_logical_disk_size_bytes{instance=\"homelab\",volume=~\"C:|D:\"} * 100)", "legendFormat": "{{volume}} used" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 85 }, { "color": "red", "value": 95 }
          ]}
        }},
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true }
      },
      {
        "id": 41, "title": "Disk I/O Read", "type": "timeseries",
        "gridPos": { "h": 5, "w": 8, "x": 8, "y": 24 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_logical_disk_read_bytes_total{instance=\"homelab\",volume=~\"C:|D:\"}[2m])", "legendFormat": "{{volume}} read" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "Bps", "decimals": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "spanNulls": true },
          "color": { "mode": "palette-classic" }
        }},
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
      },
      {
        "id": 42, "title": "Disk I/O Write", "type": "timeseries",
        "gridPos": { "h": 5, "w": 8, "x": 16, "y": 24 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_logical_disk_write_bytes_total{instance=\"homelab\",volume=~\"C:|D:\"}[2m])", "legendFormat": "{{volume}} write" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "Bps", "decimals": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "spanNulls": true },
          "color": { "mode": "palette-classic" }
        }},
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
      },
      {
        "id": 43, "title": "Disk Latency", "type": "timeseries",
        "description": "Average read/write latency per volume",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 29 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_logical_disk_read_latency_seconds_total{instance=\"homelab\",volume=~\"C:|D:\"}[2m]) / rate(windows_logical_disk_reads_total{instance=\"homelab\",volume=~\"C:|D:\"}[2m])", "legendFormat": "{{volume}} read" },
          { "expr": "rate(windows_logical_disk_write_latency_seconds_total{instance=\"homelab\",volume=~\"C:|D:\"}[2m]) / rate(windows_logical_disk_writes_total{instance=\"homelab\",volume=~\"C:|D:\"}[2m])", "legendFormat": "{{volume}} write" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "s", "decimals": 3,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }
          ]},
          "color": { "mode": "palette-classic" }
        }},
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
      },
      {
        "id": 44, "title": "Disk Queue", "type": "timeseries",
        "gridPos": { "h": 5, "w": 12, "x": 12, "y": 29 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "windows_logical_disk_requests_queued{instance=\"homelab\",volume=~\"C:|D:\"}", "legendFormat": "{{volume}} queue" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "short", "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 5 }
          ]},
          "color": { "mode": "palette-classic" }
        }},
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
      },

      { "id": 500, "title": "Network", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false },

      {
        "id": 50, "title": "Network Traffic", "type": "timeseries",
        "description": "Intel I225-V (1Gbps Ethernet)",
        "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_net_bytes_received_total{instance=\"homelab\",nic=~\"Intel.*I225.*\"}[2m])", "legendFormat": "Received" },
          { "expr": "-rate(windows_net_bytes_sent_total{instance=\"homelab\",nic=~\"Intel.*I225.*\"}[2m])", "legendFormat": "Sent" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "Bps", "decimals": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20, "spanNulls": true, "lineWidth": 2 }
        },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Received" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
            { "matcher": { "id": "byName", "options": "Sent" },
              "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] }
          ]
        },
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
      },
      {
        "id": 51, "title": "Network Errors & Drops", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_net_packets_received_errors_total{instance=\"homelab\",nic=~\"Intel.*I225.*\"}[5m])", "legendFormat": "RX Errors" },
          { "expr": "rate(windows_net_packets_outbound_errors_total{instance=\"homelab\",nic=~\"Intel.*I225.*\"}[5m])", "legendFormat": "TX Errors" },
          { "expr": "rate(windows_net_packets_received_discarded_total{instance=\"homelab\",nic=~\"Intel.*I225.*\"}[5m])", "legendFormat": "RX Drops" },
          { "expr": "rate(windows_net_packets_outbound_discarded_total{instance=\"homelab\",nic=~\"Intel.*I225.*\"}[5m])", "legendFormat": "TX Drops" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "pps", "decimals": 2,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "red", "value": 1 }
          ]},
          "color": { "mode": "palette-classic" }
        }},
        "options": { "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
      },

      { "id": 600, "title": "System", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 }, "collapsed": false },

      {
        "id": 60, "title": "Context Switches / sec", "type": "timeseries",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 43 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "rate(windows_system_context_switches_total{instance=\"homelab\"}[2m])", "legendFormat": "Ctx Switches/s" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "short", "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "spanNulls": true },
          "color": { "fixedColor": "purple", "mode": "fixed" }
        }},
        "options": { "tooltip": { "mode": "single" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] } }
      },
      {
        "id": 61, "title": "Processes & Threads", "type": "timeseries",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 43 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "windows_system_processes{instance=\"homelab\"}", "legendFormat": "Processes" },
          { "expr": "windows_system_threads{instance=\"homelab\"}", "legendFormat": "Threads" }
        ],
        "fieldConfig": { "defaults": {
          "unit": "short", "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "spanNulls": true }
        },
          "overrides": [
            { "matcher": { "id": "byName", "options": "Threads" },
