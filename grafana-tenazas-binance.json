{
  "dashboard": {
    "id": null,
    "uid": "tenazas-binance",
    "title": "Tenazas Binance",
    "tags": ["tenazas", "binance", "crypto"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "5m",
    "time": { "from": "now-7d", "to": "now" },
    "schemaVersion": 39,
    "version": 2,
    "editable": true,
    "graphTooltip": 1,
    "panels": [

      {
        "id": 100, "title": "Resumen", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },

      {
        "id": 1,
        "title": "Portfolio Total",
        "description": "Valor total portfolio Binance en USD",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_total_usd", "legendFormat": "Total USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "green", "value": null }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 2,
        "title": "PNL Hoy USD",
        "description": "Ganancia/perdida del dia en USD",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_pnl_day_usd", "legendFormat": "PNL USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 3,
        "title": "PNL Hoy %",
        "description": "Ganancia/perdida del dia en porcentaje",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 10, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_pnl_day_pct", "legendFormat": "PNL %" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 4,
        "title": "Fear & Greed",
        "description": "Crypto Fear & Greed Index (0=Extreme Fear, 100=Extreme Greed)",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 14, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_fear_greed_index", "legendFormat": "F&G" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 0,
            "min": 0,
            "max": 100,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "dark-red", "value": null },
              { "color": "red", "value": 10 },
              { "color": "orange", "value": 25 },
              { "color": "text", "value": 45 },
              { "color": "light-green", "value": 55 },
              { "color": "green", "value": 75 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 5,
        "title": "BTC Dominance",
        "description": "Bitcoin market cap dominance %",
        "type": "stat",
        "gridPos": { "h": 6, "w": 5, "x": 19, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_btc_dominance_pct", "legendFormat": "BTC Dom" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "blue", "value": null }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 200, "title": "BTC Precio & Tendencia", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
        "collapsed": false
      },

      {
        "id": 6,
        "title": "BTC Precio USD",
        "description": "Precio de Bitcoin en tiempo real con soporte/resistencia 24h",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 18, "x": 0, "y": 8 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_btc_price_usd", "legendFormat": "BTC/USD" },
          { "expr": "min_over_time(tenazas_binance_btc_price_usd[24h])", "legendFormat": "Soporte 24h" },
          { "expr": "max_over_time(tenazas_binance_btc_price_usd[24h])", "legendFormat": "Resistencia 24h" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 2,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 5,
              "pointSize": 5,
              "lineInterpolation": "smooth",
              "showPoints": "never"
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "BTC/USD" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
                { "id": "custom.lineWidth", "value": 3 },
                { "id": "custom.fillOpacity", "value": 10 }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Soporte 24h" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
                { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
                { "id": "custom.lineWidth", "value": 1 },
                { "id": "custom.fillOpacity", "value": 0 }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Resistencia 24h" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } },
                { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
                { "id": "custom.lineWidth", "value": 1 },
                { "id": "custom.fillOpacity", "value": 0 }
              ]
            }
          ]
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" },
          "tooltip": { "mode": "multi", "sort": "none" }
        }
      },

      {
        "id": 7,
        "title": "BTC Actual",
        "description": "Precio actual de Bitcoin",
        "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_btc_price_usd", "legendFormat": "BTC" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "orange", "value": null }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 8,
        "title": "BTC 24h Change",
        "description": "Variacion BTC en las ultimas 24h",
        "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 18, "y": 13 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_asset_change_24h_pct{asset=\"BTC\"}", "legendFormat": "24h %" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 300, "title": "Top Assets", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
        "collapsed": false
      },

      {
        "id": 9,
        "title": "Assets por Valor USD",
        "description": "Top assets ordenados por valor en USD",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 10, "x": 0, "y": 19 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "topk(10, tenazas_binance_asset_balance_usd)", "legendFormat": "{{asset}}" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 },
              { "color": "yellow", "value": 500 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true,
          "minVizWidth": 0,
          "minVizHeight": 15
        }
      },

      {
        "id": 10,
        "title": "Detalle Assets",
        "description": "Asset | Cantidad | Precio | Valor USD | Cambio 24h%",
        "type": "table",
        "gridPos": { "h": 8, "w": 14, "x": 10, "y": 19 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_asset_qty", "legendFormat": "{{asset}}", "refId": "A", "format": "table", "instant": true },
          { "expr": "tenazas_binance_asset_price_usd", "legendFormat": "{{asset}}", "refId": "B", "format": "table", "instant": true },
          { "expr": "tenazas_binance_asset_balance_usd", "legendFormat": "{{asset}}", "refId": "C", "format": "table", "instant": true },
          { "expr": "tenazas_binance_asset_change_24h_pct", "legendFormat": "{{asset}}", "refId": "D", "format": "table", "instant": true }
        ],
        "transformations": [
          { "id": "joinByField", "options": { "byField": "asset", "mode": "outer" } },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true,
                "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
                "instance": true, "instance 1": true, "instance 2": true, "instance 3": true,
                "job": true, "job 1": true, "job 2": true, "job 3": true
              },
              "renameByName": {
                "asset": "Asset",
                "Value #A": "Cantidad",
                "Value #B": "Precio USD",
                "Value #C": "Valor USD",
                "Value #D": "Cambio 24h%"
              },
              "indexByName": {
                "Asset": 0, "Cantidad": 1, "Precio USD": 2, "Valor USD": 3, "Cambio 24h%": 4
              }
            }
          },
          { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Valor USD", "desc": true }] } }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Precio USD" },
              "properties": [
                { "id": "unit", "value": "currencyUSD" },
                { "id": "decimals", "value": 2 }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Valor USD" },
              "properties": [
                { "id": "unit", "value": "currencyUSD" },
                { "id": "decimals", "value": 2 }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Cantidad" },
              "properties": [ { "id": "decimals", "value": 6 } ]
            },
            {
              "matcher": { "id": "byName", "options": "Cambio 24h%" },
              "properties": [
                { "id": "unit", "value": "percent" },
                { "id": "decimals", "value": 2 },
                { "id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0 } ]
                }},
                { "id": "custom.cellOptions", "value": { "type": "color-text" } }
              ]
            }
          ]
        }
      },

      {
        "id": 400, "title": "PNL Historico & Paper Trading", "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
        "collapsed": false
      },

      {
        "id": 11,
        "title": "PNL Acumulado Diario",
        "description": "PNL diario historico de Binance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 14, "x": 0, "y": 28 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_pnl_day_usd", "legendFormat": "PNL USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80,
              "lineWidth": 0,
              "gradientMode": "scheme",
              "thresholdsStyle": { "mode": "off" },
              "showPoints": "never"
            },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]},
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "legend": { "displayMode": "hidden" },
          "tooltip": { "mode": "single" }
        }
      },

      {
        "id": 12,
        "title": "Paper Portfolio",
        "description": "Valor del portfolio virtual de paper trading",
        "type": "stat",
        "gridPos": { "h": 4, "w": 5, "x": 14, "y": 28 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_paper_portfolio_usd", "legendFormat": "Paper USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "purple", "value": null }
            ]},
            "noValue": "Sin datos"
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 13,
        "title": "Win Rate",
        "description": "Porcentaje de trades ganadores en paper trading",
        "type": "stat",
        "gridPos": { "h": 4, "w": 5, "x": 19, "y": 28 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_paper_win_rate_pct", "legendFormat": "Win %" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "min": 0,
            "max": 100,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "green", "value": 55 }
            ]},
            "noValue": "Sin datos"
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 14,
        "title": "Total Trades",
        "description": "Trades cerrados en paper trading",
        "type": "stat",
        "gridPos": { "h": 4, "w": 5, "x": 14, "y": 32 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_paper_total_trades", "legendFormat": "Trades" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "purple", "value": null }
            ]},
            "noValue": "Sin datos"
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "none",
          "colorMode": "background_solid",
          "textMode": "value"
        }
      },

      {
        "id": 15,
        "title": "Fear & Greed Historico",
        "description": "Evolucion del Fear & Greed Index",
        "type": "timeseries",
        "gridPos": { "h": 4, "w": 5, "x": 19, "y": 32 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_fear_greed_index", "legendFormat": "F&G" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 100,
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 15,
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "thresholdsStyle": { "mode": "area" }
            },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "transparent", "value": 45 },
              { "color": "light-green", "value": 55 },
              { "color": "green", "value": 75 }
            ]},
            "color": { "mode": "thresholds" }
          }
        },
        "options": {
          "legend": { "displayMode": "hidden" },
          "tooltip": { "mode": "single" }
        }
      }

    ]
  },
  "overwrite": true
}
