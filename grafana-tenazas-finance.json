{
  "dashboard": {
    "id": null,
    "uid": "tenazas-finance",
    "title": "Tenazas Finance",
    "tags": ["tenazas", "finance"],
    "timezone": "America/Argentina/Buenos_Aires",
    "refresh": "5m",
    "time": { "from": "now-30d", "to": "now" },
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 100,
        "title": "Portfolio Actual",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "id": 1,
        "title": "IOL Portfolio",
        "description": "Valor total del portfolio IOL en ARS",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_iol_portfolio_ars{instance=\"openclaw\"}", "legendFormat": "IOL ARS" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyARS",
            "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "blue", "value": null }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 2,
        "title": "PNL IOL Hoy",
        "description": "PNL del dia IOL en ARS",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_iol_pnl_day_ars{instance=\"openclaw\"}", "legendFormat": "PNL ARS" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyARS",
            "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "value",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 3,
        "title": "Binance Portfolio",
        "description": "Valor total Binance en USD",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_total_usd{instance=\"openclaw\"}", "legendFormat": "Binance USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "green", "value": null }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "background",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 4,
        "title": "PNL Binance Hoy",
        "description": "PNL del dia Binance en USD",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_pnl_usd{instance=\"openclaw\"}", "legendFormat": "PNL USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 0,
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]}
          }
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "graphMode": "area",
          "colorMode": "value",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 200,
        "title": "Historico",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
        "collapsed": false
      },
      {
        "id": 5,
        "title": "Portfolio — IOL (ARS) + Binance (USD)",
        "description": "Evolucion del valor de ambos portfolios",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_iol_portfolio_ars{instance=\"openclaw\"}", "legendFormat": "IOL (ARS)" },
          { "expr": "tenazas_binance_total_usd{instance=\"openclaw\"}", "legendFormat": "Binance (USD)" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "auto",
              "spanNulls": true
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "IOL (ARS)" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
                { "id": "custom.axisPlacement", "value": "left" },
                { "id": "unit", "value": "currencyARS" }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Binance (USD)" },
              "properties": [
                { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
                { "id": "custom.axisPlacement", "value": "right" },
                { "id": "unit", "value": "currencyUSD" }
              ]
            }
          ]
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] }
        }
      },
      {
        "id": 300,
        "title": "PNL Diario",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
        "collapsed": false
      },
      {
        "id": 6,
        "title": "PNL IOL Diario (ARS)",
        "description": "Ganancia/perdida diaria IOL — verde positivo, rojo negativo",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_iol_pnl_day_ars{instance=\"openclaw\"}", "legendFormat": "PNL IOL" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyARS",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80,
              "gradientMode": "scheme",
              "thresholdsStyle": { "mode": "line" }
            },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]},
            "color": { "mode": "thresholds" }
          }
        }
      },
      {
        "id": 7,
        "title": "PNL Binance Diario (USD)",
        "description": "Ganancia/perdida diaria Binance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_pnl_usd{instance=\"openclaw\"}", "legendFormat": "PNL Binance" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80,
              "gradientMode": "scheme",
              "thresholdsStyle": { "mode": "line" }
            },
            "thresholds": { "mode": "absolute", "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]},
            "color": { "mode": "thresholds" }
          }
        }
      },
      {
        "id": 8,
        "title": "BTC Price",
        "description": "Precio BTC desde portfolio Binance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
        "datasource": { "uid": "afhjgavdgav40d", "type": "prometheus" },
        "targets": [
          { "expr": "tenazas_binance_btc_price{instance=\"openclaw\"}", "legendFormat": "BTC/USD" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 15,
              "spanNulls": true
            },
            "color": { "fixedColor": "orange", "mode": "fixed" }
          }
        }
      }
    ]
  },
  "overwrite": true
}
